PORT=5000
MONGO_URI=mongodb://localhost:27017/blog
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_REFRESH_KEY=your_jwt_refresh_key_here

# Nodemailer configuration for forgot-password email sending
USER_EMAIL=your_email@gmail.com
USER_PASS=your_email_app_password

# Cloudinary configuration for media uploads (profile picture, post & comment images)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# OAuth 2.0 Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000